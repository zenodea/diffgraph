{
  "name": "graphdiff",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "herdr plugin: review what your agent changed, as a tree, in the browser",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "node scripts/build.ts --watch",
    "serve": "node src/cli.ts serve",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "preact": "^11.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
